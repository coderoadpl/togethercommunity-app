# Server
NODE_ENV=development
APP_ENV=development
PORT=48730
APP_BASE_DOMAIN=localhost
APP_BASE_URL=http://localhost:48730
BETTER_AUTH_SECRET=change-me-to-32-random-chars-in-prod
# AES-256-GCM master key for encrypting tenant BYO secrets at rest (FR-10).
# 32 random bytes, base64. Generate: openssl rand -base64 32
# The server refuses the built-in dev default when NODE_ENV/APP_ENV=production.
SECRETS_MASTER_KEY=
SECURE_COOKIES=false

# Payment provider adapter: 'stripe' (live SDK, keys resolved per-tenant from the
# encrypted store) or 'fake' (deterministic, no network — default for local/dev).
PAYMENT_PROVIDER=fake
KSEF_ENVIRONMENT=test
KSEF_TEST_BASE_URL=https://api-test.ksef.mf.gov.pl/v2
KSEF_PRODUCTION_BASE_URL=https://api.ksef.mf.gov.pl/v2

# Dev-only PoC toggles — NEVER enable in production:
#   mount /api/dev/* simulated-purchase + magic-link sink routes
SIMULATED_PAYMENTS=false
#   persist issued magic links into dev_magic_links (no mailer in the PoC)
AUTH_DEV_EXPOSE_MAGIC_LINKS=false

# Transactional e-mail. Local/dev defaults to the database-backed dev sink.
EMAIL_PROVIDER=dev
EMAIL_FROM=
EMAIL_DISPATCH_SECRET=change-me-to-a-random-dispatch-secret
MARKETING_TICK_SECRET=change-me-to-a-random-marketing-secret
CRON_SECRET=change-me-to-a-random-vercel-cron-secret
SNS_TEST_CERT_PEM_BASE64=
EMAIL_DISPATCH_RATE_PER_SECOND=5
EMAIL_DISPATCH_INTERVAL_MS=1000
KSEF_DISPATCH_INTERVAL_MS=1000
EMAIL_DISPATCH_ATTEMPTS_CAP=5
EMAIL_DISPATCH_BACKOFF_BASE_MS=1000
EMAIL_DISPATCH_BACKOFF_CAP_MS=900000

# Community notifications: deliver thread-reply e-mails through EMAIL_PROVIDER.
# In-app (SSE) delivery is always on; this toggles only the e-mail channel.
NOTIFY_EMAIL=true

# Google social sign-in — wired ONLY when BOTH are set (no secrets committed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database — the ONLY place the platform differs:
#   local/Docker : DB_DRIVER=node-postgres
#   Vercel+Neon  : DB_DRIVER=neon-http
DB_DRIVER=node-postgres
DATABASE_URL=postgres://together:together@localhost:48912/together

# Where the built SPA lives (served by the same process)
WEB_DIST_DIR=dist/web

# Observability — ALL optional. Unset = OTel facade no-ops, zero network.
#   Server: registers an OTLP tracer only when an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=together-server
#   Web (Vite VITE_ prefix): Sentry initialises only when a DSN is set.
# VITE_SENTRY_DSN=
