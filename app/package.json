{
  "name": "together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "description": "Agent-first, strictly layered full-stack TypeScript foundation for multi-tenant SaaS",
  "imports": {
    "#core/*": "./core/*",
    "#adapters/*": "./adapters/*"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "together": "./apps/cli/bin.js"
  },
  "scripts": {
    "dev:server": "tsx scripts/ensure-web-bundle.ts && tsx watch --env-file-if-exists=.env apps/server/src/entry.node.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "pnpm run build:web && pnpm run typecheck",
    "vercel-build": "pnpm run db:migrate && pnpm run build",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage --maxWorkers=4 --test-timeout=60000 && tsx scripts/coverage-report.ts && tsx scripts/coverage-check.ts",
    "coverage:check": "tsx scripts/coverage-check.ts",
    "coverage:baseline": "vitest run --coverage --maxWorkers=4 --test-timeout=60000 && tsx scripts/coverage-report.ts --write-baseline",
    "typecheck": "tsc --noEmit",
    "typecheck:islands": "tsc --noEmit -p tsconfig.islands.json",
    "lint": "eslint .",
    "depcruise": "depcruise core adapters apps scripts",
    "knip": "knip",
    "doc-lint": "tsx scripts/doc-lint.ts",
    "license-lint": "tsx scripts/license-lint.ts",
    "licenses:generate": "tsx scripts/generate-third-party-licenses.ts",
    "permissions:generate": "tsx scripts/permission-inventory.ts",
    "permissions:check": "tsx scripts/permission-inventory.ts --check",
    "check": "pnpm run typecheck && pnpm run typecheck:islands && pnpm run lint && pnpm run lock-lint && pnpm run license-lint && pnpm run migration-lint && pnpm run depcruise && pnpm run knip && pnpm run doc-lint && pnpm run test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx adapters/db/migrate.ts",
    "db:seed": "tsx adapters/db/seed.ts",
    "db:reseed": "tsx scripts/ensure-web-bundle.ts && tsx adapters/db/reseed.ts",
    "cli": "tsx apps/cli/src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:remote": "tsx scripts/remote-smoke.ts",
    "quickstart:probe": "tsx scripts/quickstart-probe.ts",
    "a11y": "tsx scripts/a11y-scan.ts",
    "shots:poc": "tsx scripts/poc-screenshots.ts",
    "shots:parity": "tsx scripts/parity-screenshots.ts",
    "shots:themes": "tsx scripts/theme-screenshots.ts",
    "visual": "tsx scripts/visual-screenshots.ts",
    "visual:update": "tsx scripts/visual-screenshots.ts --update",
    "visual:argos-capture": "tsx scripts/visual-screenshots.ts --argos-capture",
    "legacy:export": "tsx scripts/legacy-export.ts",
    "import": "tsx scripts/import.ts",
    "e2e:auth": "tsx scripts/auth-e2e.ts",
    "e2e:coupon": "tsx scripts/coupon-e2e.ts",
    "e2e:poc": "tsx scripts/poc-e2e.ts",
    "e2e:subs": "tsx scripts/subs-e2e.ts",
    "e2e:marketing": "tsx scripts/marketing-e2e.ts",
    "e2e:ksef": "tsx scripts/ksef-e2e.ts",
    "storybook": "storybook dev -p 9009 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "visual:stories": "pnpm run storybook:build && LOST_PIXEL_DISABLE_TELEMETRY=1 lost-pixel",
    "visual:stories:update": "pnpm run storybook:build && LOST_PIXEL_DISABLE_TELEMETRY=1 lost-pixel update",
    "lock-lint": "tsx scripts/lock-lint.ts",
    "migration-lint": "tsx scripts/migration-lint.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1095.0",
    "@aws-sdk/client-sns": "^3.1095.0",
    "@better-auth/passkey": "^1.6.25",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hono/node-server": "^2.0.12",
    "@mui/material": "^9.2.0",
    "@neondatabase/serverless": "^1.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/react": "^10.68.0",
    "@tanstack/query-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "better-auth": "^1.6.25",
    "commander": "^14.0.0",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "marked": "^18.0.7",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@argos-ci/cli": "^6.5.0",
    "@eslint/js": "^9.39.5",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@storybook/react-vite": "^10.5.4",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.12.1",
    "dependency-cruiser": "^16.10.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lost-pixel": "^3.22.0",
    "mongodb": "^7.5.0",
    "msw": "^2.15.0",
    "otplib": "^13.4.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.0",
    "pngjs": "^7.0.0",
    "storybook": "^10.5.4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "2.1.3",
      "handlebars": "4.7.9",
      "smol-toml": "1.7.1",
      "unbash": "4.0.4",
      "yoctocolors": "2.2.0"
    }
  }
}
