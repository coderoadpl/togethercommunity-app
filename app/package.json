{
  "name": "together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-first, strictly layered full-stack TypeScript foundation for multi-tenant SaaS",
  "bin": {
    "together": "./apps/cli/bin.js"
  },
  "scripts": {
    "dev:server": "tsx scripts/ensure-web-bundle.ts && tsx watch --env-file-if-exists=.env apps/server/src/entry.node.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:web && npm run typecheck",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise core adapters apps scripts",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm run test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx adapters/db/migrate.ts",
    "db:seed": "tsx adapters/db/seed.ts",
    "db:reseed": "tsx scripts/ensure-web-bundle.ts && tsx adapters/db/reseed.ts",
    "cli": "tsx apps/cli/src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "shots:poc": "tsx scripts/poc-screenshots.ts",
    "shots:parity": "tsx scripts/parity-screenshots.ts",
    "shots:themes": "tsx scripts/theme-screenshots.ts",
    "visual": "tsx scripts/visual-screenshots.ts",
    "visual:update": "tsx scripts/visual-screenshots.ts --update",
    "legacy:export": "tsx scripts/legacy-export.ts",
    "import": "tsx scripts/import.ts",
    "e2e:auth": "tsx scripts/auth-e2e.ts",
    "e2e:poc": "tsx scripts/poc-e2e.ts",
    "e2e:subs": "tsx scripts/subs-e2e.ts",
    "storybook": "storybook dev -p 9009 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "visual:stories": "npm run storybook:build && LOST_PIXEL_DISABLE_TELEMETRY=1 lost-pixel",
    "visual:stories:update": "npm run storybook:build && LOST_PIXEL_DISABLE_TELEMETRY=1 lost-pixel update"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1085.0",
    "@better-auth/passkey": "^1.6.23",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@hono/node-server": "^1.17.1",
    "@mui/material": "^9.2.0",
    "@neondatabase/serverless": "^1.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@sentry/react": "^10.65.0",
    "@tanstack/query-core": "^5.83.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.130.2",
    "@types/dompurify": "^3.0.5",
    "better-auth": "^1.3.4",
    "commander": "^14.0.0",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.5",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@storybook/react-vite": "^10.5.2",
    "lost-pixel": "^3.22.0",
    "storybook": "^10.5.2",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.15.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "dependency-cruiser": "^16.10.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "mongodb": "^7.5.0",
    "msw": "^2.15.0",
    "otplib": "^13.4.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "zod-validation-error": "^4.0.2"
  }
}
