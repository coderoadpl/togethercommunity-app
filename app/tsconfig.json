{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["core", "adapters", "apps", "config-regression", "scripts/ksef-e2e.ts", "scripts/smoke.ts", "scripts/quickstart-probe.ts", "scripts/a11y-scan.ts", "scripts/ensure-web-bundle.ts", "scripts/web-bundle-freshness.ts", "scripts/auth-e2e.ts", "scripts/legacy-export.ts", "scripts/legacy-export-args.ts", "scripts/legacy-export-args.test.ts", "scripts/legacy-transform.ts", "scripts/import.ts", "scripts/import-bundle-slug.ts", "scripts/import-bundle-slug.test.ts", "scripts/legacy-transform.test.ts", "scripts/poc-e2e.ts", "scripts/subs-e2e.ts", "scripts/marketing-e2e.ts", "scripts/qa-spaces.ts", "scripts/poc-screenshots.ts", "scripts/parity-screenshots.ts", "scripts/theme-screenshots.ts", "scripts/visual-screenshots.ts", "scripts/make-sample-pdf.ts", "scripts/coverage-layers.ts", "scripts/coverage-report.ts", "scripts/coverage-check.ts", "scripts/doc-lint.ts", "scripts/lock-lint.ts", "*.config.ts", ".dependency-cruiser.cjs", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
