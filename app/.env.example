# Server
NODE_ENV=development
# Names the environment. Only 'preview' and 'staging' relax the production boot
# validations; every other value (including an unset one) keeps the strict
# posture when NODE_ENV=production, because Vercel sets NODE_ENV=production on
# Preview deployments too.
APP_ENV=development
PORT=48730
# INTERNAL_PORT=48732
# Base domain for subdomain tenant routing (acme.localhost, acme.example.com).
# Unset APP_BASE_DOMAIN for single-tenant self-hosting on the bare host.
APP_BASE_DOMAIN=localhost
APP_BASE_URL=http://localhost:48730
APP_COMMIT_SHA=
# Injected by Vercel on every deployment; never set by hand. Outside production
# they join the trusted auth origins so a preview deployment accepts requests
# made from its own generated URL.
# VERCEL_URL=
# VERCEL_BRANCH_URL=
TENANT_CREATION=open
BETTER_AUTH_SECRET=change-me-to-32-random-chars-in-prod
# Use direct when Node receives traffic directly. Behind a trusted reverse proxy,
# name only a header that the proxy overwrites before Node receives the request.
AUTH_TRUSTED_PROXY_HEADER=
# AES-256-GCM master key for encrypting tenant BYO secrets at rest (FR-10).
# 32 random bytes, base64. Generate: openssl rand -base64 32
# The server refuses the built-in dev default when NODE_ENV/APP_ENV=production.
SECRETS_MASTER_KEY=
SECURE_COOKIES=false

# Payment provider adapter: 'stripe' (live SDK, keys resolved per-tenant from the
# encrypted store) or 'fake' (deterministic, no network — default for local/dev).
PAYMENT_PROVIDER=fake
KSEF_ENVIRONMENT=test
KSEF_TEST_BASE_URL=https://api-test.ksef.mf.gov.pl/v2
KSEF_PRODUCTION_BASE_URL=https://api.ksef.mf.gov.pl/v2

# Dev-only PoC toggles — NEVER enable in production:
#   mount /api/dev/* simulated-purchase + magic-link sink routes
SIMULATED_PAYMENTS=false
#   persist issued magic links into dev_magic_links (no mailer in the PoC)
AUTH_DEV_EXPOSE_MAGIC_LINKS=false
STORAGE_ALLOW_PRIVATE_ENDPOINTS=false
PLAYBACK_TOKEN_TTL_SECONDS=21600
#   freeze server-rendered timestamps during visual harness runs
# TOGETHER_VISUAL_CLOCK=2026-07-01T12:00:00.000Z

# Transactional e-mail. Local/dev defaults to the database-backed dev sink.
# Set EMAIL_PROVIDER=smtp to send through the optional local Mailpit instance.
EMAIL_PROVIDER=dev
EMAIL_FROM=
SMTP_HOST=localhost
SMTP_PORT=48925
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_DISPATCH_SECRET=change-me-to-a-random-dispatch-secret
MARKETING_TICK_SECRET=change-me-to-a-random-marketing-secret
CRON_SECRET=change-me-to-a-random-vercel-cron-secret
SNS_TEST_CERT_PEM_BASE64=
EMAIL_DISPATCH_RATE_PER_SECOND=5
EMAIL_DISPATCH_INTERVAL_MS=1000
KSEF_DISPATCH_INTERVAL_MS=1000
CONSENT_EVIDENCE_PURGE_ENABLED=false
EMAIL_DISPATCH_ATTEMPTS_CAP=5
EMAIL_DISPATCH_BACKOFF_BASE_MS=1000
EMAIL_DISPATCH_BACKOFF_CAP_MS=900000
M2M_TRANSACTIONAL_EMAIL_RATE_PER_MINUTE=60
M2M_TRANSACTIONAL_EMAIL_RATE_PER_DAY=5000

# Public write throttles. Unset outside production means generous development
# defaults; 0 disables a bucket.
#PUBLIC_RATE_LIMIT_WRITES_PER_IP_PER_MINUTE=30
#PUBLIC_RATE_LIMIT_WRITES_PER_TENANT_PER_MINUTE=300
#PUBLIC_RATE_LIMIT_AUTH_LINKS_PER_EMAIL_PER_10_MINUTES=5

# Community notifications: deliver thread-reply e-mails through EMAIL_PROVIDER.
# In-app (SSE) delivery is always on; this toggles only the e-mail channel.
NOTIFY_EMAIL=true

# Google social sign-in — wired ONLY when BOTH are set (no secrets committed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Interactive transactions are load-bearing in runtime adapters.
# Every environment, including Vercel, must use node-postgres.
DB_DRIVER=node-postgres
DATABASE_URL=postgres://together:together@localhost:48912/together

# Where the built SPA lives (served by the same process)
WEB_DIST_DIR=dist/web

# Observability — ALL optional. Unset = OTel facade no-ops, zero network.
#   Server: registers an OTLP tracer only when an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=together-server
#   Web (Vite VITE_ prefix): Sentry initialises only when a DSN is set.
# VITE_SENTRY_DSN=
