#!/bin/sh
set -eu

ALLOWED_EMAIL="chomawerka@gmail.com"
ZERO=0000000000000000000000000000000000000000

fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha --not --remotes=origin"
  else
    range="$remote_sha..$local_sha"
  fi
  bad=$(git rev-list --no-merges --format='%h %ae %ce' $range 2>/dev/null \
    | grep -v '^commit ' \
    | awk -v ok="$ALLOWED_EMAIL" '$2 != ok || $3 != ok' || true)
  if [ -n "$bad" ]; then
    echo "pre-push: non-merge commits must be authored and committed as Weronika Choma <$ALLOWED_EMAIL>:" >&2
    echo "$bad" >&2
    echo "pre-push: fix with: git rebase --exec 'git commit --amend --no-edit --reset-author' <base>" >&2
    fail=1
  fi
done

exit $fail
